# Produção: use uma URL PostgreSQL com SSL.
DATABASE_URL=postgresql://user:password@host:5432/doctype_os?sslmode=require
DATABASE_ENGINE=postgres
# Use false somente se o provedor exigir certificado não verificável.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Usado apenas no primeiro seed. Troque a senha no primeiro acesso.
SEED_ADMIN_EMAIL=admin@doctype.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador DOCTYPE

# Desenvolvimento local sem PostgreSQL:
# DATABASE_URL=sqlite:./.data/doctype-os.db
# DATABASE_ENGINE=sqlite

# Conexões por instância no pool do Postgres. Em serverless, cada instância abre o
# próprio pool — mantenha baixo e use um pooler de transação (PgBouncer/Supabase
# Pooler/Neon pooled) na frente para não estourar o limite de conexões sob carga.
DATABASE_POOL_MAX=5

# Janela (ms) do micro-cache do estado da organização usado por /api/state. Absorve
# rajadas de polling do DOC Monitor sem servir dado desatualizado após uma gravação
# (toda escrita invalida o cache da própria organização imediatamente).
STATE_CACHE_TTL_MS=2000

# Opcional: token do Vercel Blob (Storage > Blob no dashboard da Vercel). Quando
# definido, contratos e logos grandes deixam de ser gravados como base64 na tabela
# `records` e passam a ser enviados ao Blob, guardando só a URL. Sem este token, o
# comportamento é o mesmo de hoje (arquivo inline) — nenhuma configuração extra é
# obrigatória para continuar rodando como está.
# BLOB_READ_WRITE_TOKEN=

# Cobrança automática (Pix, Cartão e Boleto) das empresas clientes do SaaS via
# Stripe. Sem estas duas variáveis, o sistema continua funcionando normalmente —
# só a ativação de cobrança automática fica indisponível (fail closed, nunca cobra
# sem querer). Ver README.md > "Cobrança automática (Stripe) em produção".
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Opcional: ID de uma "Payment method configuration" nomeada do dashboard da
# Stripe (Settings > Billing > Invoice settings > Métodos de pagamento padrão,
# ID começa com "pmc_"). Quando definida, ela vira a fonte única da verdade de
# quais métodos aparecem no checkout — inclua Pix, Cartão e Boleto nela. Sem
# esta variável, o código usa uma lista fixa (Pix/Cartão/Boleto), mas alguns
# métodos podem ficar bloqueados se a conta Stripe só os tiver ativado dentro
# de uma configuração nomeada específica (não na ativação "crua" da conta).
# STRIPE_PAYMENT_METHOD_CONFIGURATION=pmc_...

# Notificações por e-mail (Resend). Sem RESEND_API_KEY, o sistema continua
# funcionando normalmente — a notificação continua sendo criada na central
# dentro da plataforma (sino no topo), só o e-mail deixa de ser enviado (fail
# closed, nunca falha a operação por causa de e-mail). Ver README.md >
# "Notificações por e-mail (Resend)".
# RESEND_API_KEY=re_...
#
# Remetente usado nos e-mails de notificação. Sem domínio verificado no Resend
# (Domains > Add Domain), use o padrão onboarding@resend.dev — só entrega para
# o e-mail da própria conta Resend, mas serve para testar o envio.
# NOTIFICATIONS_FROM_EMAIL=DOCTYPE OS <notificacoes@seudominio.com.br>
