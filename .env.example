# Produção: use uma URL PostgreSQL com SSL.
DATABASE_URL=postgresql://user:password@host:5432/doctype_os?sslmode=require
DATABASE_ENGINE=postgres
# Use false somente se o provedor exigir certificado não verificável.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Usado apenas no primeiro seed. Troque a senha no primeiro acesso.
SEED_ADMIN_EMAIL=admin@doctype.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha
SEED_ADMIN_NAME=Administrador DOCTYPE

# Desenvolvimento local sem PostgreSQL:
# DATABASE_URL=sqlite:./.data/doctype-os.db
# DATABASE_ENGINE=sqlite

# Conexões por instância no pool do Postgres. Em serverless, cada instância abre o
# próprio pool — mantenha baixo e use um pooler de transação (PgBouncer/Supabase
# Pooler/Neon pooled) na frente para não estourar o limite de conexões sob carga.
DATABASE_POOL_MAX=5

# Janela (ms) do micro-cache do estado da organização usado por /api/state. Absorve
# rajadas de polling do DOC Monitor sem servir dado desatualizado após uma gravação
# (toda escrita invalida o cache da própria organização imediatamente).
STATE_CACHE_TTL_MS=2000

# Opcional: token do Vercel Blob (Storage > Blob no dashboard da Vercel). Quando
# definido, contratos e logos grandes deixam de ser gravados como base64 na tabela
# `records` e passam a ser enviados ao Blob, guardando só a URL. Sem este token, o
# comportamento é o mesmo de hoje (arquivo inline) — nenhuma configuração extra é
# obrigatória para continuar rodando como está.
# BLOB_READ_WRITE_TOKEN=
